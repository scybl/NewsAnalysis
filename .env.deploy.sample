# Copy this file to .env on the server, then replace every value below.

TUSHARE_API=<your-tushare-token>
TUSHARE_BASE_URL=http://api.tushare.pro
# Tushare full-history sync calls many endpoints; keep this higher if you want a gentler crawl.
TUSHARE_PAUSE_SECONDS=1.2
# Default TDX minute-K fetch mode used by the web button. "all" keeps paging until the source is exhausted.
MARKET_MINUTE_DEFAULT_PAGES=all
MARKET_MINUTE_DEFAULT_SOURCE=pytdx_history
MARKET_MINUTE_MAX_PAGES=1000
MARKET_MINUTE_PAGE_SLEEP_SECONDS=0.08
PYTDX_HISTORY_DAY_SLEEP_SECONDS=0.05
PYTDX_HISTORY_BATCH_DAYS=20
PYTDX_SOCKET_TIMEOUT_SECONDS=8
PYTDX_HISTORY_RETRY_SLEEP_SECONDS=3

# DeepSeek key is stored from the admin page, encrypted with STOCK_WEB_KEY_ENCRYPTION_SECRET.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

STOCK_WEB_USER=admin
STOCK_WEB_PASSWORD=<strong-admin-password>
STOCK_WEB_SESSION_SECRET=<long-random-secret>
STOCK_WEB_KEY_ENCRYPTION_SECRET=<long-random-secret-for-encrypted-user-api-keys>
STOCK_WEB_INVITE_CODES=
STOCK_WEB_INVITE_TTL_SECONDS=259200
STOCK_WEB_DEMO_REQUEST_LIMIT=30
STOCK_WEB_DEMO_WINDOW_SECONDS=86400
STOCK_DATA_CACHE_TTL_SECONDS=86400
STOCK_ANALYSIS_HISTORY_REVIEW_LIMIT=3
STOCK_ANALYSIS_REUSE_TTL_SECONDS=1800
STOCK_ANALYSIS_REFRESH_TTL_SECONDS=3600
STOCK_AGENT_ENGINE=legacy
STOCK_AGENT_TEMPLATE=native

# Public host port. The container always listens on 8765.
PUBLIC_WEB_PORT=8765

# MongoDB inside docker-compose.prod.yml.
MONGO_USER=admin
MONGO_PASSWORD=<strong-mongo-password>
# URL encoded version of MONGO_PASSWORD, for example Rich@2026 -> Rich%402026.
MONGO_PASSWORD_URI=<url-encoded-mongo-password>
MONGO_AUTHSOURCE=admin
MONGODB_DATABASE=news
MONGODB_COLLECTION=articles
MONGO_DB=news
MONGO_COLLECTION=articles
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=8000

GUARDIAN_API_KEY=<guardian-api-key>
GUARDIAN_BASE_URL=https://content.guardianapis.com
GUARDIAN_START_PAGE=1
GUARDIAN_END_PAGE=1
GUARDIAN_PAGE_SIZE=200
GUARDIAN_REQUEST_DELAY=0.1
GUARDIAN_REQUEST_TIMEOUT=30
GUARDIAN_RETRY_DELAY=5

CHROME_DEBUG_PORT=9225
URL_QUEUE_DATABASE=bloomberg_url_queue
URL_QUEUE_COLLECTION=urls
