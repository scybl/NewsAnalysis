# Copy this file to .deploy.env. The real file is ignored by Git.
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/newsanalysis

# Set to 1 when DEPLOY_PATH is root-owned but DEPLOY_USER has passwordless sudo.
DEPLOY_USE_SUDO=0
DEPLOY_STAGING_PATH=/home/deploy/.newsanalysis-deploy

# This URL is requested from the server after every deployment.
DEPLOY_HEALTH_URL=http://127.0.0.1:8765/api/health
DEPLOY_HEALTH_RETRIES=30

# Optional one-time cleanup for messy server deploy directories.
# Dry-run first to list what would be moved out of DEPLOY_PATH:
# DEPLOY_CLEAN=1
# DEPLOY_CLEAN_DRY_RUN=1
# Real clean deploy moves non-whitelisted items to DEPLOY_BACKUP_ROOT.
DEPLOY_CLEAN=0
DEPLOY_CLEAN_DRY_RUN=0
DEPLOY_CLEAN_KEEP=".env cache local_data logs reports sessions"
DEPLOY_BACKUP_ROOT=/opt/newsanalysis.backups
