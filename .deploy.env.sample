# Copy this file to .deploy.env. The real file is ignored by Git.
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/newsanalysis

# This URL is requested from the server after every deployment.
DEPLOY_HEALTH_URL=http://127.0.0.1:8765/api/health
DEPLOY_HEALTH_RETRIES=30
