# ===== Non-secret runtime config =====
# Do not put API keys, passwords, or account secrets in .env.
# Store sensitive values with:
# .venv/bin/python -m stock_pipeline secrets set tushare.api_token
# .venv/bin/python -m stock_pipeline secrets set web.admin_password
# .venv/bin/python -m stock_pipeline secrets set web.admin_readonly_username viewer
# .venv/bin/python -m stock_pipeline secrets set web.admin_readonly_password
# .venv/bin/python -m stock_pipeline secrets set web.session_secret
# .venv/bin/python -m stock_pipeline secrets set mongo.password
TUSHARE_BASE_URL=http://api.tushare.pro
# Tushare full-history sync calls many endpoints; keep this higher if you want a gentler crawl.
TUSHARE_PAUSE_SECONDS=1.2
# Default TDX minute-K fetch mode used by the web button. "all" keeps paging until the source is exhausted.
MARKET_MINUTE_DEFAULT_PAGES=all
MARKET_MINUTE_DEFAULT_SOURCE=pytdx_history
MARKET_MINUTE_MAX_PAGES=1000
MARKET_MINUTE_PAGE_SLEEP_SECONDS=0.08
PYTDX_HISTORY_DAY_SLEEP_SECONDS=0.05
PYTDX_HISTORY_BATCH_DAYS=20
PYTDX_SOCKET_TIMEOUT_SECONDS=8
PYTDX_HISTORY_RETRY_SLEEP_SECONDS=3

# DeepSeek key is stored from the admin page or the encrypted secret store.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Stock web auth =====
STOCK_WEB_HOST=127.0.0.1
STOCK_WEB_PORT=8765

# Optional bootstrap invite codes. Normal invites should be generated from the admin page.
STOCK_WEB_INVITE_CODES=
STOCK_WEB_INVITE_TTL_SECONDS=259200

# Defaults used when admin generates demo accounts.
STOCK_WEB_DEMO_REQUEST_LIMIT=30
STOCK_WEB_DEMO_WINDOW_SECONDS=86400

# Shared stock data cache and LLM analysis review.
DATA_FETCH_APPROVAL_REQUIRED=1
STOCK_DATA_CACHE_TTL_SECONDS=86400
STOCK_ANALYSIS_HISTORY_REVIEW_LIMIT=3
STOCK_ANALYSIS_REUSE_TTL_SECONDS=1800
STOCK_ANALYSIS_REFRESH_TTL_SECONDS=3600
STOCK_AGENT_ENGINE=legacy
STOCK_AGENT_TEMPLATE=native
IDLE_STOCK_PREFETCH_ENABLED=1
IDLE_STOCK_PREFETCH_SECONDS=1800
IDLE_STOCK_PREFETCH_MINUTES_ENABLED=1

# ===== MongoDB =====
MONGODB_DATABASE=news
MONGODB_RAW_COLLECTION=raw_articles
MONGODB_ANALYSIS_INGESTION_COLLECTION=analysis_ingestion_state
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=admin
MONGO_AUTHSOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=8000
MARKET_MINUTE_DATABASE=stock_market
MARKET_MINUTE_COLLECTION=minute_day_buckets
NEWS_CRAWLER_INTERVAL_SECONDS=1800
NEWS_CRAWLER_MAX_PAGES=1
NEWS_CRAWLER_DISABLED_SOURCES=bloomberg
