# ===== Core API keys =====
TUSHARE_API=<your-tushare-token>
TUSHARE_BASE_URL=http://api.tushare.pro

DEEPSEEK_API=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Stock web auth =====
STOCK_WEB_HOST=127.0.0.1
STOCK_WEB_PORT=8765
STOCK_WEB_USER=admin
STOCK_WEB_PASSWORD=<change-me>
STOCK_WEB_SESSION_SECRET=<random-secret>
STOCK_WEB_KEY_ENCRYPTION_SECRET=<long-random-secret-for-encrypted-user-api-keys>

# Optional bootstrap invite codes. Normal invites should be generated from the admin page.
STOCK_WEB_INVITE_CODES=
STOCK_WEB_INVITE_TTL_SECONDS=259200

# Defaults used when admin generates demo accounts.
STOCK_WEB_DEMO_REQUEST_LIMIT=30
STOCK_WEB_DEMO_WINDOW_SECONDS=86400

# Shared stock data cache and LLM analysis review.
STOCK_DATA_CACHE_TTL_SECONDS=86400
STOCK_ANALYSIS_HISTORY_REVIEW_LIMIT=3
STOCK_ANALYSIS_REUSE_TTL_SECONDS=1800

# ===== MongoDB =====
MONGODB_URI=mongodb://<user>:<url-encoded-password>@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=news
MONGODB_COLLECTION=articles
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=news
MONGO_COLLECTION=articles
MONGO_USER=<mongo-user>
MONGO_PASSWORD=<mongo-password>
# URL encoded version of MONGO_PASSWORD, for example Rich@2026 -> Rich%402026.
MONGO_PASSWORD_URI=<url-encoded-mongo-password>
MONGO_AUTHSOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=8000

# ===== NewsWeaver optional sources =====
GUARDIAN_API_KEY=<guardian-api-key>
GUARDIAN_BASE_URL=https://content.guardianapis.com
GUARDIAN_START_PAGE=1
GUARDIAN_END_PAGE=1
GUARDIAN_PAGE_SIZE=200
GUARDIAN_REQUEST_DELAY=0.1
GUARDIAN_REQUEST_TIMEOUT=30
GUARDIAN_RETRY_DELAY=5

# ===== SSH tunnel for remote MongoDB =====
SSH_HOST=<ssh-host>
SSH_PORT=7022
SSH_USER=tunnel
SSH_KEY_PATH=<path-to-private-key>
SSH_KEY_PASSPHRASE=
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=27017

CHROME_DEBUG_PORT=9225
URL_QUEUE_DATABASE=bloomberg_url_queue
URL_QUEUE_COLLECTION=urls
