MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=news
MONGODB_RAW_COLLECTION=raw_articles
MONGODB_RUNS_COLLECTION=crawl_runs
GUARDIAN_API_KEY=
GUARDIAN_API_KEY_FILE=
GUARDIAN_BASE_URL=https://content.guardianapis.com
BLOOMBERG_LATEST_URL=https://www.bloomberg.com/latest
# Optional authenticated Cookie header. Keep this in a secret, never commit it.
BLOOMBERG_COOKIE=
BLOOMBERG_COOKIE_FILE=
# Bloomberg commonly requires an authenticated Cookie. Remove it here after configuring BLOOMBERG_COOKIE.
NEWS_CRAWLER_DISABLED_SOURCES=bloomberg
