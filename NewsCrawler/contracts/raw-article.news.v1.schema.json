{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw-article.news.v1.schema.json",
  "title": "Raw Article news.v1",
  "type": "object",
  "required": [
    "schema_version",
    "article_id",
    "source_name",
    "url",
    "canonical_url",
    "title",
    "content",
    "published_at",
    "fetched_at"
  ],
  "properties": {
    "schema_version": {"const": "news.v1"},
    "article_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string", "minLength": 1},
    "external_id": {"type": ["string", "null"]},
    "url": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "content": {"type": "string"},
    "published_at": {"type": "string"},
    "fetched_at": {"type": "string"},
    "section": {"type": "string"},
    "language": {"type": "string"},
    "author": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string"},
    "title_time_hash": {"type": "string"},
    "raw_metadata": {"type": "object"}
  },
  "additionalProperties": true
}
